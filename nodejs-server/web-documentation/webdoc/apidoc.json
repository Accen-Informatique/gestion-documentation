    "definitions": {
        "AccenResponse": {
            "type": "object",
            "properties": { "code": { "type": "integer" }, "message": { "type": "string" }, "data": { "type": "object" } } 
        },
        "Login":{
            "type":"object",
            "properties":{
                "login":{"type":"string","description":"courriel de connexion"},
                "pwd":{"type":"string","description":"mot de passe de connexion"}
            }
        },
        "LoginResponse": {
            "type": "object",
            "properties": { 
                "code": { "type": "integer" }, 
                "message": { "type": "string" }, 
                "data": { "type": "array", "items": { "$ref":"#/definitions/LoginResponseDetail"}  }
            }
        },
        "LoginResponseDetail":{ 
            "type": "object",
            "properties": {
                "vtoken": { "type": "string", "description":"Clé obligatoire afin de pouvoir consommer les autres services web" },
                "vkey": { "type": "string", "description":"Clé obligatoire afin de pouvoir consommer les autres services web"  },
                "firstname": {"type":"string","description":"Prénom"},
                "lastname": {"type":"string","description":"Nom"},                                
                "fullname": {"type":"string","description":"Nom complet"},
                "address": {"type":"string","description":"Adresse principale"},
                "address2": {"type":"string","description":"Adresse complémentaire (facultatif)"},
                "zipcode": {"type":"string","description":"Code postal"},
                "city": {"type":"string","description":"Ville"},
                "country": {"type":"string","description":"Pays"},
                "phone": {"type":"string","description":"Numéro de téléphone fixe"},
                "mobile": {"type":"string","description":"Numéro de téléphone mobile"},
                "email": {"type":"string","description":"Courriel"},
                "birthday": {"type":"string","description":"Date de naissance au format AAAA-MM-JJ"},
                "iban": {"type":"string","description":"Code IBAN"},
                "bic": {"type":"string","description":"Code BIC"},
                "civilite": {"type":"string","description":"Civilité (Monsieur ou Madame)"}
            }
        },
        "LoginExist":{
            "type":"object",
            "properties":{
                "login":{"type":"string","description":"courriel de connexion"}
            }
        },
        "AccountResponse": {
            "type": "object",
            "properties": { 
                "code": { "type": "integer" }, 
                "message": { "type": "string" }, 
                "data": { "type": "array", "items": { "$ref":"#/definitions/AccountDetail"}  }
            }
        },
