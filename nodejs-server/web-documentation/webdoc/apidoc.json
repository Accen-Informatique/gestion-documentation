                "lastname": {"type":"string","description":"Nom","required":true},                                
                "address": {"type":"string","description":"Adresse principale","required":true},
                "address2": {"type":"string","description":"Adresse complémentaire (facultatif)"},
                "zipcode": {"type":"string","description":"Code postal","required":true},
                "city": {"type":"string","description":"Ville","required":true},
                "country": {"type":"string","description":"Pays"},
                "phone": {"type":"string","description":"Numéro de téléphone fixe"},
