            "type": "object",
            "properties": {
                "code": { "type": "string", "description":"Identifiant ACCEN" },
                "firstname": {"type":"string","description":"Prénom"},
                "lastname": {"type":"string","description":"Nom"},                                
                "fullname": {"type":"string","description":"Nom complet"},
                "address": {"type":"string","description":"Adresse principale"},
                "address2": {"type":"string","description":"Adresse complémentaire (facultatif)"},
                "zipcode": {"type":"string","description":"Code postal"},
                "city": {"type":"string","description":"Ville"},
                "country": {"type":"string","description":"Pays"},
                "phone": {"type":"string","description":"Numéro de téléphone fixe"},
                "mobile": {"type":"string","description":"Numéro de téléphone mobile"},
                "email": {"type":"string","description":"Courriel"},
                "birthday": {"type":"string","description":"Date de naissance au format AAAA-MM-JJ"},
                "iban": {"type":"string","description":"Code IBAN"},
                "bic": {"type":"string","description":"Code BIC"},
                "is_main_bank": {"type":"string","description":"Indication s'il est titulaire du compte bancaire (oui / non)"},
                "civilite": {"type":"string","description":"Civilité (Monsieur ou Madame)"}
